# =============================================================================
# HelpDesk DevSecOps - Variables d'environnement (DONNÉES FICTIVES)
# Copier : cp .env.example .env   (le fichier .env n'est jamais versionné)
# =============================================================================
# Valeurs EXEMPLE uniquement. Remplacez-les localement; ne déployez jamais ces valeurs.
POSTGRES_DB=helpdesk_example
POSTGRES_USER=helpdesk_example
POSTGRES_PASSWORD=EXAMPLE_ONLY_change_this_password

# Utilisées par le backend lancé à la main avec `npm start` (phase 1) :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_example
DB_USER=helpdesk_example
DB_PASSWORD=EXAMPLE_ONLY_change_this_password
PORT=3000
ENABLE_DEMO_SEED=true

# Secret JWT (phase 4) : à GÉNÉRER vous-même, jamais à écrire dans un fichier versionné.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Collez le résultat dans votre fichier .env (pas dans ce fichier d'exemple).
JWT_SECRET=
