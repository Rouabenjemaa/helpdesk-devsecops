# =============================================================================
# HelpDesk DevSecOps - Variables d'environnement (DONNÉES FICTIVES)
# Copier : cp .env.example .env   (le fichier .env n'est jamais versionné)
# =============================================================================
# Utilisées par docker-compose.yml (phase 2) pour créer la base :
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change_me_fictif_123

# Utilisées par le backend lancé à la main avec `npm start` (phase 1) :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASSWORD=change_me_fictif_123
PORT=3000

# Secret JWT (phase 4) : à GÉNÉRER vous-même, jamais à écrire dans un fichier versionné.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Collez le résultat dans votre fichier .env (pas dans ce fichier d'exemple).
JWT_SECRET=
